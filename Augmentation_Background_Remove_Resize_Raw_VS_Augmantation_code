{"cells":[{"cell_type":"code","execution_count":1,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":17297,"status":"ok","timestamp":1766690908414,"user":{"displayName":"ChatGPT Premium","userId":"04876280344470298445"},"user_tz":-360},"id":"IN0AR4MmFYnv","outputId":"3761fa1a-b1af-4b3c-a1aa-0614e201d4fe"},"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n"]}],"source":["from google.colab import drive\n","drive.mount('/content/drive')"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"QRREcgpQMw6r"},"outputs":[],"source":["# Install required packages (Colab)\n","!pip install -q albumentations opencv-python rembg scikit-learn pillow onnxruntime\n","!pip install -q rembg pillow numpy\n","\n","import os\n","import random\n","import numpy as np\n","from PIL import Image, ImageEnhance, ImageOps, ImageFilter\n","from rembg import remove\n","\n","\n","# ==========================\n","# Paths\n","# ==========================\n","dataset_path = \"/content/drive/MyDrive/Mango Leaf Dataset/Raw Images\"\n","output_augmented = \"/content/drive/MyDrive/Mango Leaf Dataset/Augmented Images\"\n","os.makedirs(output_augmented, exist_ok=True)\n","\n","# ==========================\n","# Parameters\n","# ==========================\n","image_size = (224, 224)\n","random.seed(42)\n","np.random.seed(42)\n","\n","# ==========================\n","# Augmentation Functions\n","# ==========================\n","def rotate_image(img):\n","    angle = random.choice([15, -15, 30, -30, 45, -45])\n","    return img.rotate(angle), f\"Rotation{angle}deg\"\n","\n","def flip_image(img):\n","    flip_type = random.choice([\"Horizontal\", \"Vertical\"])\n","    if flip_type == \"Horizontal\":\n","        return img.transpose(Image.FLIP_LEFT_RIGHT), \"FlipHorizontal\"\n","    else:\n","        return img.transpose(Image.FLIP_TOP_BOTTOM), \"FlipVertical\"\n","\n","def brightness_image(img):\n","    factor = random.uniform(0.6, 1.4)\n","    enhancer = ImageEnhance.Brightness(img)\n","    return enhancer.enhance(factor), f\"Brightness{factor:.2f}\"\n","\n","def shear_image(img):\n","    shear_factor = random.choice([10, -10, 15, -15, 20, -20])\n","    w, h = img.size\n","    matrix = (1, np.tan(np.radians(shear_factor)), 0, 0, 1, 0)\n","    img_sheared = img.transform((w, h), Image.AFFINE, matrix, Image.BICUBIC, fillcolor=(255,255,255))\n","    return img_sheared, f\"Shear{shear_factor}deg\"\n","\n","def blur_image(img):\n","    sigma = random.uniform(0.5, 1.0)\n","    return img.filter(ImageFilter.GaussianBlur(radius=sigma)), f\"Blur{sigma:.2f}\"\n","\n","def contrast_image(img):\n","    factor = random.uniform(0.7, 1.3)\n","    enhancer = ImageEnhance.Contrast(img)\n","    return enhancer.enhance(factor), f\"Contrast{factor:.2f}\"\n","\n","# ==========================\n","# Background Remove + Resize\n","# ==========================\n","def remove_bg_and_resize(img):\n","    img_no_bg = remove(img)\n","    img_rgb = Image.new(\"RGB\", img_no_bg.size, (255, 255, 255))\n","    img_rgb.paste(img_no_bg, mask=img_no_bg.split()[3])\n","    return img_rgb.resize(image_size, Image.LANCZOS)\n","\n","# ==========================\n","# Apply All 6 Augmentations\n","# ==========================\n","def augment_image(img):\n","    funcs = [rotate_image, flip_image, brightness_image, shear_image, blur_image, contrast_image]\n","    augmented_images = []\n","    for func in funcs:\n","        aug_img, aug_name = func(img)\n","        augmented_images.append((aug_img, aug_name))\n","    return augmented_images\n","\n","# ==========================\n","# Process Dataset\n","# ==========================\n","def process_dataset(dataset_path, output_augmented):\n","    for cls in sorted(os.listdir(dataset_path)):\n","        cls_path = os.path.join(dataset_path, cls)\n","        if not os.path.isdir(cls_path):\n","            continue\n","\n","        save_cls_path = os.path.join(output_augmented, cls)\n","        os.makedirs(save_cls_path, exist_ok=True)\n","        print(f\"Processing class: {cls}\")\n","\n","        for img_name in sorted(os.listdir(cls_path)):\n","            if not img_name.lower().endswith(('.jpg', '.jpeg', '.png')):\n","                continue\n","\n","            img_path = os.path.join(cls_path, img_name)\n","            try:\n","                img = Image.open(img_path).convert(\"RGB\")\n","\n","                # 1️⃣ Remove background + resize (original)\n","                img_clean = remove_bg_and_resize(img)\n","                base_name = os.path.splitext(img_name)[0]\n","                img_clean.save(os.path.join(save_cls_path, f\"{base_name}_Original.jpg\"))\n","\n","                # 2️⃣ Apply 6 augmentations\n","                for i, (aug_img, aug_name) in enumerate(augment_image(img_clean), start=1):\n","                    aug_clean = remove_bg_and_resize(aug_img)\n","                    aug_clean.save(os.path.join(save_cls_path, f\"{base_name}_aug{i}_{aug_name}.jpg\"))\n","\n","            except Exception as e:\n","                print(f\"❌ Error processing {img_name}: {e}\")\n","\n","# ==========================\n","# Run\n","# ==========================\n","process_dataset(dataset_path, output_augmented)\n","print(\"Dataset augmentation + background removal + resize completed successfully!\")\n"]},{"cell_type":"markdown","source":["# **Raw And Augmented Dataset Simple Showing**"],"metadata":{"id":"e5PFq4JA8llM"}},{"cell_type":"code","source":["import os\n","from PIL import Image\n","import matplotlib.pyplot as plt\n","from matplotlib.gridspec import GridSpec\n","import random\n","\n","def preview_and_save(src_dir):\n","    class_folders = [f for f in os.listdir(src_dir) if os.path.isdir(os.path.join(src_dir, f))]\n","\n","    for cls in class_folders:\n","        cls_folder = os.path.join(src_dir, cls)\n","        images = [f for f in os.listdir(cls_folder) if f.lower().endswith(('.jpg','.jpeg','.png'))]\n","\n","        # Pick one raw image (contains \"Original\")\n","        raw_images = [f for f in images if \"Original\" in f]\n","        if not raw_images:\n","            print(f\"⚠️ No raw images found for class: {cls}\")\n","            continue\n","\n","        raw_img_name = random.choice(raw_images)\n","        raw_img_path = os.path.join(cls_folder, raw_img_name)\n","        raw_img = Image.open(raw_img_path)\n","\n","        # Extract base name of raw image\n","        base_name = raw_img_name.split(\"_Original\")[0]\n","\n","        # Pick augmentations corresponding to this raw image\n","        aug_images = [f for f in images if (f.startswith(base_name) and \"_aug\" in f)]\n","        aug_images = sorted(aug_images)[:6]  # max 6\n","\n","        if not aug_images:\n","            print(f\"⚠️ No augmentations found for {raw_img_name}\")\n","            continue\n","\n","        # === Create figure ===\n","        fig = plt.figure(figsize=(20, 10))\n","        gs = GridSpec(2, 5, figure=fig, width_ratios=[2, 0.3, 1, 1, 1], wspace=0.2, hspace=0.3)\n","\n","        # Raw image (left column, spanning 2 rows)\n","        ax_raw = fig.add_subplot(gs[:, 0])\n","        ax_raw.imshow(raw_img)\n","        ax_raw.axis(\"off\")\n","        ax_raw.text(0.5, -0.05, f\"{cls}\\nRaw\", fontsize=22, fontweight=\"bold\", color=\"darkgreen\",\n","                    ha=\"center\", va=\"top\", transform=ax_raw.transAxes)\n","\n","        # Arrow\n","        ax_arrow = fig.add_subplot(gs[:, 1])\n","        ax_arrow.text(0.5, 0.5, \"→\", fontsize=60, ha=\"center\", va=\"center\", fontweight=\"bold\", color=\"black\")\n","        ax_arrow.axis(\"off\")\n","\n","        # Augmented images (2 rows × 3 columns)\n","        for i, aug_name in enumerate(aug_images):\n","            row = i // 3\n","            col = i % 3\n","            ax = fig.add_subplot(gs[row, col+2])\n","            aug_img = Image.open(os.path.join(cls_folder, aug_name))\n","            ax.imshow(aug_img)\n","            ax.axis(\"off\")\n","\n","            # Extract clean augmentation label\n","            try:\n","                aug_type = aug_name.split(\"_\")[-1]  # last part\n","                aug_type = aug_type.replace(\".jpg\",\"\").replace(\".jpeg\",\"\").replace(\".png\",\"\")\n","                aug_type = aug_type.replace(\"-\", \" \").replace(\"deg\", \"°\")\n","            except:\n","                aug_type = \"Augmented\"\n","\n","            ax.text(0.5, -0.05, aug_type, fontsize=18, fontweight=\"bold\", color=\"darkblue\",\n","                    ha=\"center\", va=\"top\", transform=ax.transAxes)\n","\n","        plt.tight_layout()\n","\n","        # Save figure\n","        save_file = os.path.join(src_dir, f\"{cls}_{base_name}_preview.png\")\n","        fig.savefig(save_file, dpi=300, bbox_inches=\"tight\")\n","        plt.close(fig)\n","\n","        print(f\"✅ Preview saved for class: {cls} → {save_file}\")\n","\n","\n","# === Run ===\n","output_dir = \"/content/drive/MyDrive/Mango Leaf Dataset/Augmented Data\"\n","preview_and_save(output_dir)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"zVjL8vI_kDbS","executionInfo":{"status":"ok","timestamp":1759855962030,"user_tz":-360,"elapsed":31207,"user":{"displayName":"ChatGPT Premium","userId":"04876280344470298445"}},"outputId":"42b25e51-afde-46c3-d56d-9916e69626db"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stderr","text":["/tmp/ipython-input-3493086597.py:71: UserWarning: This figure includes Axes that are not compatible with tight_layout, so results might be incorrect.\n","  plt.tight_layout()\n"]},{"output_type":"stream","name":"stdout","text":["✅ Preview saved for class: Amrupali → /content/drive/MyDrive/Mango Leaf Dataset/Augmented Data/Amrupali_Amrupali_074_preview.png\n","✅ Preview saved for class: Banana → /content/drive/MyDrive/Mango Leaf Dataset/Augmented Data/Banana_Banana_051_preview.png\n","✅ Preview saved for class: Bandigori → /content/drive/MyDrive/Mang