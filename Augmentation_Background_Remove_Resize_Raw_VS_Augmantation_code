isdir(cls_folder):\n","            n = len([f for f in os.listdir(cls_folder) if f.lower().endswith(('.jpg','.jpeg','.png'))])\n","            counts[cls] = n\n","    return counts\n","\n","# Counts\n","raw_counts = count_images(dataset_path)\n","aug_counts = count_images(aug_path)\n","\n","# Same order\n","classes = sorted(raw_counts.keys())\n","raw_vals = [raw_counts[c] for c in classes]\n","aug_vals = [aug_counts.get(c, 0) for c in classes]\n","\n","y = np.arange(len(classes))\n","height = 0.35\n","\n","# Create figure\n","fig, ax = plt.subplots(figsize=(14, 8))\n","\n","# Horizontal bars\n","bars_raw = ax.barh(y - height/2, raw_vals, height, color='#1f77b4', edgecolor='black', linewidth=0.7)\n","bars_aug = ax.barh(y + height/2, aug_vals, height, color='#ff7f0e', edgecolor='black', linewidth=0.7)\n","\n","# Add gridlines\n","ax.xaxis.grid(True, linestyle='--', alpha=0.5)\n","\n","# Labels and title\n","ax.set_yticks(y)\n","ax.set_yticklabels(classes, fontsize=13, fontweight='bold')\n","ax.set_xlabel('Number of Images', fontsize=14, fontweight='bold')\n","ax.set_title('Distribution of Original vs Augmented Images per Class', fontsize=18, fontweight='bold')\n","\n","# Annotate bars\n","for bar in bars_raw + bars_aug:\n","    width = int(bar.get_width())\n","    ax.annotate(f'{width}',\n","                xy=(width, bar.get_y() + bar.get_height()/2),\n","                xytext=(5, 0),\n","                textcoords=\"offset points\",\n","                ha='left', va='center',\n","                fontsize=11, fontweight='bold', color='black')\n","\n","# Place legend below the graph\n","ax.legend(['Original', 'Augmented'], fontsize=13, loc='upper center',\n","          bbox_to_anchor=(0.5, -0.12), ncol=2, frameon=False)\n","\n","plt.tight_layout()\n","plt.savefig(save_chart, dpi=300, bbox_inches='tight')\n","plt.show()\n","\n","print(f\"Enhanced Horizontal Grand Chart with bottom legend saved at: {save_chart}\")\n"]},{"cell_type":"code","execution_count":null,"metada